# Spotify AI Support Agent — Environment Variables

# Google Gemini API key — get yours free at: https://aistudio.google.com/apikey
# No billing required. Free tier gives 1500 requests/day on Flash models.
GEMINI_API_KEY=your_gemini_api_key_here

# Model config — tweak these to trade off speed vs quality
# The chat model generates agent responses; the judge model evaluates them.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite
